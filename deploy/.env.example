# Easiest path: let deploy/selfhost.sh write this file for you (see docs/setup-guide.md).
# --- Required ---
# Bare domain, no https://. Its DNS A record must point at this server.
VAULT_DOMAIN=vault.example.com
# Where Let's Encrypt sends certificate expiry notices.
ACME_EMAIL=admin@example.com
# 32 random bytes, base64:  openssl rand -base64 32
SERVER_SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Public key from `age-keygen` — keep the PRIVATE key OFFLINE (password manager of last resort / safe).
BACKUP_AGE_RECIPIENT=

# --- Optional ---
ALLOW_SIGNUP=false
# Where backups are written, relative to deploy/. The backup container fixes its ownership itself.
BACKUP_DIR=./backups
BACKUP_HOUR_UTC=2
BACKUP_RETAIN_DAILY=30
BACKUP_RETAIN_MONTHLY=12
# rclone remote for off-host copies, e.g. "s3remote:arevei-vault-backups" (configure rclone.conf in the backup image)
BACKUP_RCLONE_REMOTE=
RUST_LOG=info
