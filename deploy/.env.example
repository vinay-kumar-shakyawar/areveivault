# --- Required ---
VAULT_DOMAIN=vault.arevei.com
ACME_EMAIL=admin@arevei.com
# 32 random bytes, base64:  openssl rand -base64 32
SERVER_SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Public key from `age-keygen` — keep the PRIVATE key OFFLINE (password manager of last resort / safe).
BACKUP_AGE_RECIPIENT=

# --- Optional ---
ALLOW_SIGNUP=false
BACKUP_DIR=./backups
BACKUP_HOUR_UTC=2
BACKUP_RETAIN_DAILY=30
BACKUP_RETAIN_MONTHLY=12
# rclone remote for off-host copies, e.g. "s3remote:arevei-vault-backups" (configure rclone.conf in the backup image)
BACKUP_RCLONE_REMOTE=
RUST_LOG=info
