{
  "name": "arevei-vault",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "pnpm build:wasm && pnpm -r --filter ./packages/* build && pnpm --filter web build && pnpm --filter extension build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  }
}
