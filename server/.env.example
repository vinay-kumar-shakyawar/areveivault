# --- required ---
DATABASE_URL=postgres://arevei:change-me@127.0.0.1:55432/arevei
# 32 random bytes, hex or base64:  openssl rand -hex 32
# Derives the keys that encrypt account TOTP seeds and the OPAQUE server setup, and
# signs audit checkpoints. Losing it locks every account out of MFA and login: back it up offline.
SERVER_SECRET_KEY=

# --- optional (defaults shown) ---
REDIS_URL=redis://127.0.0.1:56379
BIND_ADDR=0.0.0.0:8080
# Exact origin of the web app; other Origins are refused on state-changing requests.
PUBLIC_ORIGIN=https://vault.arevei.com
# Allow new organizations to self-register (multi-tenant). Off: first signup bootstraps, then invite-only.
ALLOW_SIGNUP=false
# Honor X-Forwarded-For (only behind a trusted reverse proxy such as Caddy).
TRUST_PROXY=false
SESSION_IDLE_SECS=43200
SESSION_ABSOLUTE_SECS=604800
ATTACHMENT_DIR=./data/attachments
RATE_LIMIT_PER_MIN=10
REDIS_PREFIX=av
RUST_LOG=info,sqlx=warn
