# --- required ---
DATABASE_URL=postgres://arevei:change-me@127.0.0.1:55432/arevei
# 32 random bytes, hex or base64:  openssl rand -hex 32
# Derives the keys that encrypt account TOTP seeds and the OPAQUE server setup, and
# signs audit checkpoints. Losing it locks every account out of MFA and login: back it up offline.
SERVER_SECRET_KEY=

# --- optional (defaults shown) ---
REDIS_URL=redis://127.0.0.1:56379
BIND_ADDR=0.0.0.0:8080
# Exact origin of the web app; other Origins are refused on state-changing requests.
PUBLIC_ORIGIN=https://vault.arevei.com
# Where the landing page is served. The "talk to us about self-hosting" form redirects to
# LANDING_URL/thanks.html. Default: PUBLIC_ORIGIN/welcome.
# LANDING_URL=https://vault.arevei.com/welcome
# Email staff about each self-hosting request (optional; without SMTP_HOST nothing is sent).
# Ports 465 and 2465 are TLS from the start; any other port uses STARTTLS. Some hosts (Render's
# free plan) block outbound 25, 465 and 587: with Resend, use 2587 there.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_FROM=info@joincloud.in
# SMTP_FROM_NAME=Arevei Vault
# CONTACT_NOTIFY_TO=vinay@arevei.com
# CONTACT_NOTIFY_CC=varun@arevei.com,rishabh@arevei.com
# Allow new organizations to self-register (multi-tenant). Off: first signup bootstraps, then invite-only.
ALLOW_SIGNUP=false
# Honor X-Forwarded-For (only behind a trusted reverse proxy such as Caddy).
TRUST_PROXY=false
SESSION_IDLE_SECS=43200
SESSION_ABSOLUTE_SECS=604800
ATTACHMENT_DIR=./data/attachments
RATE_LIMIT_PER_MIN=10
REDIS_PREFIX=av
RUST_LOG=info,sqlx=warn
